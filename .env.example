# 이 파일을 복사해서 backend/.env 로 만든 뒤 값을 채워 주세요. (.env 는 GitHub에 올라가지 않아요)

# Render PostgreSQL 의 "External Database URL" 을 그대로 붙여 넣어요.
DATABASE_URL=postgresql://사용자:비밀번호@호스트/DB이름

# 이 과제는 DB 안의 hw2 공간(스키마)만 써요. 1주차 과제 테이블과 섞이지 않아요.
DB_SCHEMA=hw2

# 로그인 출입증(토큰)을 만드는 비밀 글자. 아무 긴 글자를 넣어 주세요.
JWT_SECRET=아무_긴_글자를_넣어_주세요

# 화면(코어 웹, 어드민)의 주소. 쉼표로 여러 개.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

PORT=4000

# 규정 챗봇(Dify). 없으면 챗봇은 "아직 연결되지 않았어요"로 안내해요.
DIFY_API_URL=
DIFY_API_KEY=

# 어드민의 "가상 데이터 다시 채우기" 버튼. 배포 후 실수로 지우지 않으려면 false 로 바꿔요. (기본: 켜짐)
DEMO_RESET_ENABLED=true
